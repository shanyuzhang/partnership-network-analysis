# ---- 数据不进仓库 ----
# 原始数据（FactSet Revere、Worldscope、CSMAR）是商业授权数据库；
# 清洗后的数据放在 Google Drive，见各文件夹的 DATA.md
data/
*.dta
*.zip
*.csv
# 结果表的 csv 版本保留（GitHub 上能直接显示成表格）
!**/output/tables/*.csv

# ---- 本机路径设置 ----
**/code/00_config_local.do

# ---- 运行日志（含本机路径）----
**/output/logs/
*.log
*.smcl

# ---- 系统文件 ----
.DS_Store
